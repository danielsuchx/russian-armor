{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Russian Armor Network",
  "version": "2.3.0",
  "identifier": "app.russian-armor.network",
  "build": {
    "frontendDist": "../native-assets"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "zastava"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0QjJEMDA1QzQ5MjEwNUEKUldSYUVKTEVCZEN5cEE5R1JsaWFnbFVoWi9hRmExZExpTUpiaGdadjZ2ZTJ3a1R3MzUxMy91SkkK",
      "endpoints": [
        "https://github.com/danielsuchx/russian-armor/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
